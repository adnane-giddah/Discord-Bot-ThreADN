# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set to a guild ID during development for instant (guild-scoped) command registration.
# Leave blank to register commands globally (can take up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# Path to the SQLite database file
DB_PATH=./data/bot.sqlite3

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Thread defaults
DEFAULT_AUTO_ARCHIVE_MINUTES=1440
DEFAULT_THREAD_TYPE=public

# Bulk operation safety thresholds
# Below this count, a single Confirm click is enough.
BULK_CONFIRM_THRESHOLD=25
# Above this count, Administrator permission is required regardless of confirmation.
BULK_HARD_MAX=500

# Discord permission required to run bulk thread creation commands (see PermissionsBitField flag names)
REQUIRED_PERMISSION=ManageThreads

# Minimum delay (ms) between individual thread creation calls, to stay gentle on rate limits
THREAD_CREATE_DELAY_MS=300
